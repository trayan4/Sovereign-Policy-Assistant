{
  "realm": "sovereign-policy",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "standard_staff",
        "description": "Can ask policy questions. No access to confidential-classified policies."
      },
      {
        "name": "cleared_staff",
        "description": "Authorized to see confidential-classified policies in addition to everything standard_staff can see."
      },
      {
        "name": "compliance_admin",
        "description": "Can view the compliance dashboard (query volume, escalations) and review/approve flagged governance conflicts. Independent of cleared_staff - a different kind of access, not a superset or subset of it."
      }
    ]
  },
  "users": [
    {
      "username": "standard_user",
      "enabled": true,
      "email": "standard_user@example.internal",
      "emailVerified": true,
      "firstName": "Standard",
      "lastName": "Demo User",
      "credentials": [
        {"type": "password", "value": "demo1234", "temporary": false}
      ],
      "requiredActions": [],
      "realmRoles": ["standard_staff"]
    },
    {
      "username": "cleared_user",
      "enabled": true,
      "email": "cleared_user@example.internal",
      "emailVerified": true,
      "firstName": "Cleared",
      "lastName": "Demo User",
      "credentials": [
        {"type": "password", "value": "demo1234", "temporary": false}
      ],
      "requiredActions": [],
      "realmRoles": ["cleared_staff"]
    },
    {
      "username": "admin_user",
      "enabled": true,
      "email": "admin_user@example.internal",
      "emailVerified": true,
      "firstName": "Compliance",
      "lastName": "Demo Admin",
      "credentials": [
        {"type": "password", "value": "demo1234", "temporary": false}
      ],
      "requiredActions": [],
      "realmRoles": ["compliance_admin"]
    }
  ],
  "clients": [
    {
      "clientId": "sovereign-policy-app",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "sovereign-policy-app",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
